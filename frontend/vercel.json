{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_API_URL": "https://goldtrace-ghana-production.up.railway.app/api/v1"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
