# ---- Django ----
DJANGO_SECRET_KEY=replace-with-a-50-char-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- MongoDB Atlas ----
# Atlas: Database > Connect > Drivers. Keep credentials out of source control.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_NAME=goldtrace

# ---- Redis / Celery ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# ---- CORS (React dev server) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Domain ----
BLOCKCHAIN_ANCHORING_ENABLED=False
# URL of the Fabric Gateway sidecar (blockchain/gateway)
FABRIC_GATEWAY_URL=http://localhost:4000
GOLD_PASSPORT_BASE_URL=https://verify.goldtrace.gov.gh
LOG_LEVEL=INFO
